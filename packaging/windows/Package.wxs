<?xml version="1.0" encoding="UTF-8"?>
<!--
  EyeSaver installer.

  Deliberately a per-user install into %LocalAppData%\Programs, so that installing needs no
  administrator rights and no UAC prompt - this is a tray utility, not a system component.

  The Start Menu shortcut is not decoration. Windows attributes a toast notification to an
  AppUserModelID, and the only way to register one for a desktop application is to put it
  on a shortcut. Without this, reminders would appear with a generic name or not at all.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define ProductName = "EyeSaver" ?>
  <?define Manufacturer = "EyeSaver" ?>
  <?define AppUserModelId = "com.eyesaver.app" ?>
  <!-- Never change: this is what lets a new version replace an old one. -->
  <?define UpgradeCode = "9F3A6D52-7C41-4E8B-9A1D-2B5E8C4F7A63" ?>

  <Package
      Name="$(var.ProductName)"
      Manufacturer="$(var.Manufacturer)"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perUser"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="EyeSaver - look away from the screen every 20 minutes" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="EyeSaverIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EyeSaverIcon" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="$(var.ProductName)" />
    </StandardDirectory>

    <!-- Start EyeSaver as soon as it is installed or upgraded, rather than leaving the user
         to go and find it in the Start Menu. It runs after InstallFinalize, so the shortcut
         that gives its notifications a name already exists, and without waiting, so the
         installer can finish. Not on uninstall, and not for a silent (/qn) install, which
         should not put a window on anyone's screen. -->
    <!-- Running the installer over an existing install updates it (MajorUpgrade, above),
         but EyeSaver is normally running at the time, and Windows will not replace an
         executable that is in use: the update would be put off until the next restart, or
         stopped by a "files in use" prompt. So stop it first, before InstallValidate goes
         looking for files in use. This also runs on uninstall, for the same reason.

         It is killed rather than asked to quit because the version being replaced may not
         know how to be asked, and that is safe: settings are only ever written by an atomic
         rename (see store.rs). WixQuietExec runs taskkill without flashing a console
         window. Its exit code is ignored, since "not running" is reported as a failure. -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Action="SetCloseEyeSaverCommand"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM eye-saver.exe"
                 Before="CloseEyeSaver"
                 Sequence="execute" />
    <CustomAction Id="CloseEyeSaver"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="immediate"
                  Return="ignore" />

    <!-- EyeSaver writes the "start at login" Run value itself; remove it on uninstall so
         nothing is left pointing at a deleted executable. Only on a real uninstall: an
         update removes the old version too, and must leave the login item alone, or
         updating would quietly turn "start at login" off while the settings window went
         on showing it ticked. (A RemoveRegistryValue element cannot do this - despite the
         name it deletes when the component is installed, not when it is removed.) -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Action="SetRemoveLoginItemCommand"
                 Value="&quot;[System64Folder]reg.exe&quot; delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v EyeSaver /f"
                 Before="RemoveLoginItem"
                 Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RemoveLoginItem"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="LaunchEyeSaver"
                  FileRef="EyeSaverExe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="CloseEyeSaver" Before="InstallValidate" />
      <Custom Action="RemoveLoginItem"
              After="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchEyeSaver"
              After="InstallFinalize"
              Condition="NOT Installed AND UILevel &gt; 2" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ComponentGroup Id="ProductComponents">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="EyeSaverExe" Source="$(var.ExePath)" Name="eye-saver.exe" KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="*">
        <Shortcut Id="EyeSaverShortcut"
                  Name="$(var.ProductName)"
                  Description="Look away from the screen every 20 minutes"
                  Target="[INSTALLFOLDER]eye-saver.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="EyeSaverIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppUserModelId)" />
        </Shortcut>
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\EyeSaver"
            Name="InstallFolder"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
