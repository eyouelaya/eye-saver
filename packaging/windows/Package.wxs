<?xml version="1.0" encoding="UTF-8"?>
<!--
  EyeSaver installer.

  Deliberately a per-user install into %LocalAppData%\Programs, so that installing needs no
  administrator rights and no UAC prompt - this is a tray utility, not a system component.

  The Start Menu shortcut is not decoration. Windows attributes a toast notification to an
  AppUserModelID, and the only way to register one for a desktop application is to put it
  on a shortcut. Without this, reminders would appear with a generic name or not at all.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define ProductName = "EyeSaver" ?>
  <?define Manufacturer = "EyeSaver" ?>
  <?define AppUserModelId = "com.eyesaver.app" ?>
  <!-- Never change: this is what lets a new version replace an old one. -->
  <?define UpgradeCode = "9F3A6D52-7C41-4E8B-9A1D-2B5E8C4F7A63" ?>

  <Package
      Name="$(var.ProductName)"
      Manufacturer="$(var.Manufacturer)"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perUser"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="EyeSaver - look away from the screen every 20 minutes" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="EyeSaverIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EyeSaverIcon" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="$(var.ProductName)" />
    </StandardDirectory>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ComponentGroup Id="ProductComponents">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="EyeSaverExe" Source="$(var.ExePath)" Name="eye-saver.exe" KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="*">
        <Shortcut Id="EyeSaverShortcut"
                  Name="$(var.ProductName)"
                  Description="Look away from the screen every 20 minutes"
                  Target="[INSTALLFOLDER]eye-saver.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="EyeSaverIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppUserModelId)" />
        </Shortcut>
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <!-- EyeSaver writes this itself when the user turns on "start at login"; tidy it
             away on uninstall so nothing is left pointing at a deleted executable. -->
        <RemoveRegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="EyeSaver" />
        <RegistryValue
            Root="HKCU"
            Key="Software\EyeSaver"
            Name="InstallFolder"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
